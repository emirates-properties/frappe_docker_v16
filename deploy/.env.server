# Server-side env for frappe_docker deployment
# Copy to the server, rename to `.env`, then fill in the <...> placeholders.

# ---- Image (points at what you pushed from local to ghcr.io) ----
CUSTOM_IMAGE=ghcr.io/emirates-properties/erpnext
CUSTOM_TAG=v16
PULL_POLICY=always

# ---- Frappe/ERPNext version (informational; image tag above is what actually gets pulled) ----
ERPNEXT_VERSION=v16

# ---- Database ----
# Strong password. Generate with: openssl rand -base64 24
DB_PASSWORD=<CHANGE_ME_STRONG_DB_PASSWORD>

# ---- TLS / Traefik ----
LETSENCRYPT_EMAIL=<LETSENCRYPT_EMAIL>
# Keep the backticks, they are required by Traefik.
SITES_RULE=Host(`<ERP_DOMAIN>`)

# ---- Site resolution ----
# Must match <ERP_DOMAIN> because that's what the browser sends as Host header.
FRAPPE_SITE_NAME_HEADER=<ERP_DOMAIN>

# ---- Publish ports (host -> proxy) ----
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443

# ---- Upload / proxy tuning (optional) ----
CLIENT_MAX_BODY_SIZE=50m
PROXY_READ_TIMEOUT=120
